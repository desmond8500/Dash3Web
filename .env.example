# Par défaut, l'application utilise le serveur de production https://dash3.yonkou.info :
#  - en dev (npm run dev), via le proxy Vite (/api/v1 -> https://dash3.yonkou.info/api/v1)
#  - en build (npm run build), en appel direct à https://dash3.yonkou.info/api/v1
# Rien à configurer pour ce cas.

# Travailler sur un Laravel local en dev :
# VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Forcer une autre URL d'API (dev et build) :
# VITE_API_URL=https://dash3.yonkou.info/api/v1
