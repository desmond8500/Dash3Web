# URL de base de l'API Dash3 (sans slash final).
# En dev, laisser /api/v1 : Vite relaie vers VITE_DEV_API_TARGET.
VITE_API_URL=/api/v1

# Cible du proxy Vite en développement (Laravel local)
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Production, par exemple :
# VITE_API_URL=https://dash3.yonkou.info/api/v1
